# Ejemplo de variables de entorno (sin credenciales reales)
# Copia este archivo a infra/.env antes de `docker-compose up --build`.

POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=
POSTGRES_DB=helpdesk
POSTGRES_PORT=55432

BACKEND_PORT=8000
FRONTEND_PORT=8080

# Solo para la demostracion local; cambialas si el entorno es compartido.
DEV_ADMIN_PASSWORD=
DEV_TECH_PASSWORD=
DEV_CLIENT_PASSWORD=

# Opcional: si se usa una URL completa en vez de las variables POSTGRES_*.
DATABASE_URL=

# El backend lee FRONTEND_ORIGINS desde el compose; el frontend recibe
# VITE_API_URL como argumento de build. No escribas secretos aqui.
