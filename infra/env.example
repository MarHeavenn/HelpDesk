# Copia este archivo a infra/.env y ajusta los valores si hace falta.
# infra/.env esta ignorado por git: no subas credenciales reales.
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev
POSTGRES_DB=helpdesk
# Si el 5432 esta ocupado por un PostgreSQL local, usa otro puerto (por
# ejemplo 55432). El contenedor sigue escuchando en 5432 por dentro.
POSTGRES_PORT=5432

# El backend no lee este archivo: exporta DATABASE_URL en tu shell.
# PowerShell: $env:DATABASE_URL="postgresql://helpdesk:helpdesk_dev@127.0.0.1:5432/helpdesk"
DATABASE_URL=postgresql://helpdesk:helpdesk_dev@127.0.0.1:5432/helpdesk
